{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wdb.pipeline/1",
  "title": "Pipeline working subject",
  "type": "object",
  "required": ["schema", "id", "type", "name", "prompts", "links", "dirty", "sections"],
  "properties": {
    "schema": {"const": "wdb.pipeline/1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "type": {
      "enum": [
        "character", "npc", "enemy", "sub-boss", "boss", "equipment", "item",
        "projectile", "decoration", "resource", "ui", "biome", "building", "vfx"
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "body_type": {"type": ["string", "null"]},
    "template_of": {"type": ["string", "null"]},
    "draw_scale": {"type": "number"},
    "prompts": {"type": "object"},
    "links": {"type": "array"},
    "dirty": {"type": "object"},
    "sections": {"type": "object"},
    "assets": {"type": "object"},
    "review": {"type": "object"},
    "exported_at": {"type": ["string", "null"]}
  }
}
