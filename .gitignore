# Godot
.godot/
addons/
/android/
*.translation
export_credentials.cfg
export_credentials.cfg.uid

# Commit-linked archive checkouts and Pages preview dumps
.archive_worktrees/
.archive_export_cache/
/_pages/*
!/_pages/.gdignore

# Local Copilot sweep notes (do not commit)
/_logs/*
!/_logs/.gdignore

# Same-worktree Build continuity (not a task file; not under _logs, so a direct read is allowed)
session-plan.md
/session-context.md

# Local scratch from asset processing
/_old/*
!/_old/.gdignore
_atk_*.jpg
_inspect_*.jpg
_rng*.jpg
_gen_*.jpg
_rngw_*.jpg

# Animation Browser review pipeline (local only)
tools/anim_review/

# Python
__pycache__/
*.pyc

# OS / editor
Thumbs.db
.DS_Store
*.tmp
*.bak
godot-*.log
godot-*.err
_godot_*.log
_godot_*.err
.vscode/settings.json

# Scratch Runners
tools/_scratch.py

# Shot tooling hand-over folder (run_shot_flow.py --publish); Grok Build places files into assets/ when needed
/_out/*
!/_out/.gdignore
tools/__scratch.py

# Downloaded model weights and tool caches (tools/imglib/scunet.py)
/_cache/*
!/_cache/.gdignore
opencode.json

# Comfy character outputs. Rebuild with: python tools/media.py comfy-character setup
# The approve book and the Good/Bad marks stay in git.
/_src/comfy-character/depth/
/_src/comfy-character/walk-reel/
/_src/comfy-character/walk-good/
/_src/comfy-character/walk-test/
/_src/comfy-character/frames/
/_src/comfy-character/lora-set/
