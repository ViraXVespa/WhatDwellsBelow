{
  "name": "camp-receptionist-menu",
  "about": "Placeholdia: talk to the receptionist with a gamepad. Root is Talk and Ask?. Talk shows the once-line, Ask? opens a topic, two How-to-Play pages, then close with B.",
  "scene": "camp",
  "hud": 1,
  "settle_ms": 1500,
  "covers": ["interact:receptionist", "ui:receptionist", "ui:guide"],
  "smoke": true,
  "steps": [
    {"op": "device", "kind": "pad"},
    {"op": "set", "target": "App.prog.quests_offered", "value": [
      {"kind": "kill", "title": "Cull the bat", "type": "bat", "need": 5, "have": 0, "reward": "xp"},
      {"kind": "ore", "title": "Mail 8 ore", "need": 8, "have": 0, "reward": "gold"},
      {"kind": "fetch", "title": "Retrieve a guild cache from floor 1", "floor": 1, "have": 0, "need": 1, "reward": "gear"}
    ]},
    {"op": "interact", "kind": "receptionist", "near": true},
    {"op": "assert", "target": "App.ui_open", "equals": true},
    {"op": "assert", "target": "host.ui.mode", "equals": "receptionist"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "menu-open", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["Talk", "Ask"]},
    {"op": "press", "pad": "A"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "talk-line", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["First time"]},
    {"op": "press", "pad": "B"},
    {"op": "wait", "ms": 250},
    {"op": "press", "pad": "DOWN"},
    {"op": "press", "pad": "A"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "ask-open", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["Forging", "Gathering"]},
    {"op": "press", "pad": "A"},
    {"op": "wait", "ms": 500},
    {"op": "assert", "target": "host.ui.mode", "equals": "guide"},
    {"op": "shot", "name": "page-forging", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["Forging", "anvil"]},
    {"op": "press", "pad": "B"},
    {"op": "wait", "ms": 300},
    {"op": "press", "pad": "DOWN"},
    {"op": "press", "pad": "A"},
    {"op": "wait", "ms": 500},
    {"op": "shot", "name": "page-xp", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["Experience"]},
    {"op": "press", "pad": "B"},
    {"op": "press", "pad": "B"},
    {"op": "press", "pad": "B"},
    {"op": "assert", "target": "App.ui_open", "equals": false},
    {"op": "shot", "name": "menu-closed"}
  ]
}
