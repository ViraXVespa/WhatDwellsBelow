{
  "name": "camp-pause-pages",
  "about": "Placeholdia: pause Settings pages (gameplay, audio, graphics, controls, Patreon, Main Menu, Quit), the Main Menu confirm, the Skills tab, and an inventory tab and its flyout attempt. Also holds every frame and assert of camp-pause-menu and camp-pause-inventory. Survey frames. D-pad Down moves the settings list; A on Main Menu opens the confirm; B cancels it.",
  "scene": "camp",
  "hud": 0,
  "settle_ms": 1500,
  "smoke": true,
  "steps": [
    {"op": "device", "kind": "pad"},
    {"op": "call", "target": "App.pause_menu", "method": "show_menu"},
    {"op": "assert", "target": "App.pause_menu.visible", "equals": true},
    {"op": "assert", "target": "App.pause_menu.tab", "equals": 0},
    {"op": "wait", "ms": 500},
    {"op": "shot", "name": "settings-gameplay", "texts": true},
    {"op": "assert_texts", "min_font": 14},
    {"op": "press", "pad": "DOWN"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "settings-audio", "texts": true},
    {"op": "press", "pad": "DOWN"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "settings-graphics", "texts": true},
    {"op": "press", "pad": "DOWN"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "settings-controls", "texts": true},
    {"op": "press", "pad": "DOWN"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "settings-patreon", "texts": true},
    {"op": "press", "pad": "DOWN"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "settings-main-menu", "texts": true},
    {"op": "press", "pad": "A"},
    {"op": "wait", "ms": 250},
    {"op": "shot", "name": "confirm-main-menu", "texts": true},
    {"op": "press", "pad": "B"},
    {"op": "wait", "ms": 200},
    {"op": "press", "pad": "DOWN"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "settings-quit", "texts": true},
    {"op": "set", "target": "App.pause_menu.tab", "value": 2},
    {"op": "call", "target": "App.pause_menu", "method": "_rebuild"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "pause-skills", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["Skills"]},
    {"op": "set", "target": "App.pause_menu.tab", "value": 1},
    {"op": "call", "target": "App.pause_menu", "method": "_rebuild"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "pause-inventory", "texts": true},
    {"op": "assert_texts", "min_font": 14, "must_contain": ["Inventory"]},
    {"op": "press", "pad": "Y"},
    {"op": "wait", "ms": 200},
    {"op": "shot", "name": "pause-inventory-tip", "texts": true},
    {"op": "call", "target": "App.pause_menu", "method": "close_ui"},
    {"op": "assert", "target": "App.pause_menu.visible", "equals": false}
  ]
}
