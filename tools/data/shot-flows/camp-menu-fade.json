{
  "name": "camp-menu-fade",
  "about": "Placeholdia, fixed 60 fps: menu transitions (Settings > UI > Menu transitions, scripts/ui/menu_fade.gd). The pause menu and the inventory panel are each shot mid fade-in, at rest, mid fade-out and closed. debug/menu_fade_check.gd asserts focus lands in the menu mid-fade, a pad press mid-fade is not eaten, a closing menu is a disabled ghost (game unpaused, no focus, a click does not reach it), rapid toggles settle, the setting off is instant, and two planted ghost faults (still processing, keeps focus) are caught.",
  "scene": "camp",
  "hud": 1,
  "settle_ms": 1500,
  "fixed_fps": 60,
  "smoke": true,
  "steps": [
    {"op": "device", "kind": "pad"},
    {"op": "shot", "name": "play"},
    {"op": "assert", "target": "script:debug/menu_fade_check.open_pause", "equals": "ok"},
    {"op": "wait", "frames": 1},
    {"op": "assert", "target": "script:debug/menu_fade_check.mid_in", "equals": ""},
    {"op": "shot", "name": "pause-open-mid"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "pause-rest"},
    {"op": "assert", "target": "script:debug/menu_fade_check.rest_in", "equals": ""},
    {"op": "assert", "target": "script:debug/menu_fade_check.close_pause", "equals": "ok"},
    {"op": "wait", "frames": 1},
    {"op": "assert", "target": "script:debug/menu_fade_check.mid_out", "equals": ""},
    {"op": "shot", "name": "pause-close-mid"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "pause-closed"},
    {"op": "assert", "target": "script:debug/menu_fade_check.rest_out", "equals": ""},
    {"op": "call", "target": "host.ui", "method": "open_inventory"},
    {"op": "wait", "frames": 1},
    {"op": "shot", "name": "inv-open-mid"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "inv-rest"},
    {"op": "call", "target": "host.ui", "method": "close_ui"},
    {"op": "wait", "frames": 1},
    {"op": "shot", "name": "inv-close-mid"},
    {"op": "assert", "target": "host.ui.open", "equals": false},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "inv-closed"},
    {"op": "assert", "target": "host.ui.visible", "equals": false},
    {"op": "call", "target": "App.pause_menu", "method": "show_menu"},
    {"op": "wait", "frames": 1},
    {"op": "assert", "target": "App.pause_menu.sys_page", "equals": "main"},
    {"op": "press", "pad": "DOWN"},
    {"op": "assert", "target": "script:debug/menu_fade_check.mid_in", "equals": ""},
    {"op": "wait", "ms": 300},
    {"op": "shot", "name": "pause-pad-mid-fade", "texts": true},
    {"op": "assert_texts", "must_contain": ["Master volume"]},
    {"op": "call", "target": "App.pause_menu", "method": "close_ui"},
    {"op": "repeat", "max": 6, "steps": [
      {"op": "assert", "target": "script:debug/menu_fade_check.toggle_pause", "equals": "ok"},
      {"op": "wait", "frames": 2}
    ]},
    {"op": "wait", "ms": 400},
    {"op": "assert", "target": "script:debug/menu_fade_check.settled", "equals": ""},
    {"op": "assert", "target": "App.pause_menu.open", "equals": false},
    {"op": "assert", "target": "script:debug/menu_fade_check.toggle_pause", "equals": "ok"},
    {"op": "assert", "target": "script:debug/menu_fade_check.toggle_pause", "equals": "ok"},
    {"op": "assert", "target": "script:debug/menu_fade_check.toggle_pause", "equals": "ok"},
    {"op": "wait", "ms": 400},
    {"op": "assert", "target": "script:debug/menu_fade_check.settled", "equals": ""},
    {"op": "assert", "target": "App.pause_menu.open", "equals": true},
    {"op": "call", "target": "App.pause_menu", "method": "close_ui"},
    {"op": "wait", "ms": 400},
    {"op": "assert", "target": "script:debug/menu_fade_check.off_instant", "equals": ""},
    {"op": "assert", "target": "script:debug/menu_fade_check.plant_caught", "equals": "caught"},
    {"op": "wait", "ms": 400},
    {"op": "assert", "target": "script:debug/menu_fade_check.rest_out", "equals": ""}
  ]
}
