{
  "name": "dungeon-bow-mode",
  "about": "Dungeon floor 1, seed 42, pad scheme, fixed 60 fps, enemies frozen: Bow mode (Settings > Gameplay, scripts/world/player/bow_mode.gd). debug/bow_mode_check.gd: with Bow mode off RT does not shoot and X does; on, RT shoots; holding LT (aim) while walking down keeps the right-stick aim (no turn to the walk), slows the walk and shows the aim line with the setting off (shot); a melee weapon ignores Bow mode. Planted: Bow mode off must make the RT-shoots and aiming checks fail.",
  "scene": "dungeon",
  "seed": 42,
  "floor": 1,
  "zoom": 1.5,
  "settle_ms": 0,
  "fixed_fps": 60,
  "covers": [],
  "smoke": true,
  "steps": [
    {"op": "freeze", "group": "enemies"},
    {"op": "device", "kind": "pad"},
    {"op": "wait", "ms": 1200},
    {"op": "assert", "target": "script:debug/bow_mode_check.setup", "equals": "ok"},
    {"op": "assert", "target": "script:debug/bow_mode_check.press_fire", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.fire_idle", "equals": ""},
    {"op": "wait", "ms": 900},
    {"op": "assert", "target": "script:debug/bow_mode_check.press_attack", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.attack_shoots", "equals": ""},
    {"op": "wait", "ms": 900},
    {"op": "assert", "target": "script:debug/bow_mode_check.bow_on", "equals": "ok"},
    {"op": "assert", "target": "script:debug/bow_mode_check.press_fire", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.fire_shoots", "equals": ""},
    {"op": "wait", "ms": 900},
    {"op": "assert", "target": "script:debug/bow_mode_check.stick_right", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.aim_walk_down", "equals": "ok"},
    {"op": "wait", "frames": 20},
    {"op": "shot", "name": "bow-aiming"},
    {"op": "assert", "target": "script:debug/bow_mode_check.aiming", "equals": ""},
    {"op": "wait", "ms": 300},
    {"op": "assert", "target": "script:debug/bow_mode_check.plant_off", "equals": "ok"},
    {"op": "assert", "target": "script:debug/bow_mode_check.press_fire", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.fire_shoots", "not_equals": ""},
    {"op": "wait", "ms": 900},
    {"op": "assert", "target": "script:debug/bow_mode_check.stick_right", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.aim_walk_down", "equals": "ok"},
    {"op": "wait", "frames": 20},
    {"op": "assert", "target": "script:debug/bow_mode_check.aiming", "not_equals": ""},
    {"op": "assert", "target": "script:debug/bow_mode_check.axe", "equals": "ok"},
    {"op": "assert", "target": "script:debug/bow_mode_check.press_fire", "equals": "ok"},
    {"op": "wait", "frames": 6},
    {"op": "assert", "target": "script:debug/bow_mode_check.fire_idle", "equals": ""},
    {"op": "assert", "target": "script:debug/bow_mode_check.release", "equals": "ok"}
  ]
}
