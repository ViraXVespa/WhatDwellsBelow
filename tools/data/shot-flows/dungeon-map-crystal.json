{
  "name": "dungeon-map-crystal",
  "about": "Dungeon floor 1, seed 42: the large map, then the floor crystal root, local map, and floor list. Survey frames. Enemies stay frozen. Deepest floor is seeded so the floor list is populated.",
  "scene": "dungeon",
  "seed": 42,
  "floor": 1,
  "zoom": 1.5,
  "settle_ms": 0,
  "fixed_fps": 60,
  "hud": 1,
  "smoke": true,
  "steps": [
    {"op": "freeze", "group": "enemies"},
    {"op": "assert", "target": "App.floor_n", "equals": 1},
    {"op": "wait", "ms": 1500},
    {"op": "press", "action": "map_view"},
    {"op": "wait", "ms": 400},
    {"op": "shot", "name": "large-map", "texts": true},
    {"op": "press", "action": "map_view"},
    {"op": "wait", "ms": 200},
    {"op": "set", "target": "App.prog.deepest", "value": 8},
    {"op": "interact", "kind": "crystal", "near": true},
    {"op": "assert", "target": "group:crystal_ui.page", "equals": "root"},
    {"op": "wait", "ms": 300},
    {"op": "shot", "name": "crystal-root", "texts": true},
    {"op": "set", "target": "group:crystal_ui.page", "value": "local"},
    {"op": "call", "target": "group:crystal_ui", "method": "_rebuild"},
    {"op": "wait", "ms": 300},
    {"op": "shot", "name": "crystal-local", "texts": true},
    {"op": "set", "target": "group:crystal_ui.page", "value": "floors"},
    {"op": "call", "target": "group:crystal_ui", "method": "_rebuild"},
    {"op": "wait", "ms": 300},
    {"op": "shot", "name": "crystal-floors", "texts": true},
    {"op": "call", "target": "group:crystal_ui", "method": "close_ui"}
  ]
}
