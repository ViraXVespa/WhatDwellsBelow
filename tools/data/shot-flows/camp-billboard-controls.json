{
  "name": "camp-billboard-controls",
  "about": "Placeholdia: read the Controls Billboard (open_controls), keyboard glyphs, then close with Escape. Template for a keyboard-driven static info panel.",
  "scene": "camp",
  "hud": 0,
  "settle_ms": 1500,
  "covers": ["interact:billboard", "ui:controls"],
  "smoke": true,
  "steps": [
    {"op": "device", "kind": "kb"},
    {"op": "interact", "kind": "billboard"},
    {"op": "assert", "target": "host.ui.mode", "equals": "controls"},
    {"op": "shot", "name": "controls", "texts": true},
    {"op": "assert_texts", "min_font": 14},
    {"op": "press", "key": "Escape"},
    {"op": "assert", "target": "App.ui_open", "equals": false}
  ]
}
