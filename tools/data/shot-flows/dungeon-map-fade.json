{
  "name": "dungeon-map-fade",
  "about": "Dungeon floor 1, seed 42, fixed 60 fps, enemies frozen: the large map fades in like a menu (Menu transitions, scripts/ui/menu_fade.gd) and closes at once. Shots: mid fade-in, at rest, closed. Opens with host.toggle_map (a pressed map_view needs tree.current_scene, which the capture SubViewport leaves null).",
  "scene": "dungeon",
  "seed": 42,
  "floor": 1,
  "zoom": 1.5,
  "settle_ms": 0,
  "fixed_fps": 60,
  "hud": 1,
  "smoke": true,
  "steps": [
    {"op": "freeze", "group": "enemies"},
    {"op": "wait", "ms": 1500},
    {"op": "call", "target": "host", "method": "toggle_map"},
    {"op": "assert", "target": "host.map_state", "equals": "full"},
    {"op": "assert", "target": "script:debug/menu_fade_check.map_mid", "equals": ""},
    {"op": "wait", "frames": 1},
    {"op": "shot", "name": "map-open-mid"},
    {"op": "wait", "ms": 400},
    {"op": "assert", "target": "script:debug/menu_fade_check.map_rest", "equals": ""},
    {"op": "shot", "name": "map-rest"},
    {"op": "call", "target": "host", "method": "toggle_map"},
    {"op": "assert", "target": "host.map_layer.visible", "equals": false},
    {"op": "wait", "frames": 1},
    {"op": "shot", "name": "map-closed"}
  ]
}
