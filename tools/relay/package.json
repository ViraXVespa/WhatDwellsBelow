{
  "name": "wdb-bug-relay",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker: in-game bug reports -> GitHub issues (tools/relay/README.md)",
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "doors": "node gen-doors.mjs",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "npm run types && tsc -p tsconfig.json",
    "dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "miniflare": "5.20261104.0-beta",
    "sql.js": "^1.12.0",
    "typescript": "7.0.2",
    "wrangler": "4.158.0"
  }
}
